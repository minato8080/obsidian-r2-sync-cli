{
  "name": "r2-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Obsidian未起動時でもRemotely Save互換の暗号化形式でCloudflare R2と双方向同期する",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync": "node src/index.js",
    "sync:apply": "node src/index.js --apply",
    "sync:full": "node src/index.js --apply --allow-delete",
    "setup-hooks": "git config core.hooksPath .githooks",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node tests/node/test-ignore.mjs && node tests/node/test-sync.mjs && node tests/node/test-full.mjs",
    "test:python": "python -m unittest discover -s tests/python -p \"test_*.py\"",
    "build": "esbuild src/index.js --bundle --minify --platform=node --target=node18 --format=cjs --outfile=dist/r2-sync.bundle.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@fyears/rclone-crypt": "^0.0.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "base32768": "2.0.2"
  }
}
