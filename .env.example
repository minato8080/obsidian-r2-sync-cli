# 同期対象のObsidian vaultへの絶対パス
VAULT_PATH=C:\path\to\your\vault

# Cloudflare R2
# エンドポイントは https://<account-id>.r2.cloudflarestorage.com 形式
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# バケット内で使うプレフィックス（任意、Remotely Save側の設定と合わせる。空なら未使用）
R2_REMOTE_PREFIX=

# Remotely Save の暗号化パスワード（rclone-base64方式、Obsidianの設定画面と同じ値）
SYNC_PASSWORD=

# 追加で除外したいパスパターン（カンマ区切り、任意）
# ignore.js が既定で除外するのは .git/, node_modules/, .DS_Store, Thumbs.db のみ。
# vault固有の除外(秘匿フォルダ、このツール自身の配置先、Obsidianの端末固有UI状態ファイル等)は
# 全てここで指定する。
# - "foo/"   : ルート相対でfoo/配下すべて
# - "foo/bar": ルート相対の完全一致
# - "**/foo" または単に "foo"（スラッシュなし）: 深さ問わず名前がfooのファイル/ディレクトリ
#
# 例(このツールをvault内 scripts/js/r2-sync/ に配置し、Obsidianの端末固有状態や
#     秘匿フォルダ private/ を除外したい場合):
# IGNORE_EXTRA=.env,scripts/js/r2-sync/,private/,.obsidian/plugins/remotely-save/data.json,.obsidian/workspace.json,.obsidian/workspace-mobile.json,.obsidian/graph.json,.obsidian/community-plugins.json
IGNORE_EXTRA=
